  "translations.s8": "Тил азырынча өчүк: котормолорду алдын ала даярдаса болот, келүүчүлөр аларды «Колдонуучулар → Тилдер» бөлүмүндө күйгүзгөндөн кийин көрүшөт.",
  "translations.s9": "Бул түрдөгү материалдар азырынча жок.",
  "yurt.artkyUzuk.description": "Ууктардын үстүнөн куполдун жогорку, арткы бөлүгүн жапкан кийиз.",
  "yurt.artkyUzuk.eyebrow": "Куполдун үстүңкү кийизи",
  "yurt.artkyUzuk.group": "Жабуу",
  "yurt.artkyUzuk.meaning": "Узуктардын четтерин жүн шнур менен кайышат — бул кооздук да, кийизди эскирүүдөн коргоо да.",
  "yurt.artkyUzuk.name": "Арткы узук",
  "yurt.artkyUzuk.purpose": "Күмбөздү жамгырдан, кардан жана шамалдан коргоп, ичиндеги жылуулукту сактайт.",
  "yurt.artkyUzuk.related.0": "Астыңкы узук",
  "yurt.artkyUzuk.related.1": "Түндүк жабуу",
  "yurt.artkyUzuk.related.2": "Кырчоо",
  "yurt.astynkyUzuk.description": "Куполдун керегеден жогорку узукка чейин ууктардын үстүнө жайылган астыңкы кийизи.",
  "yurt.astynkyUzuk.eyebrow": "Куполдун астыңкы кийизи",
  "yurt.astynkyUzuk.group": "Жабуу",
  "yurt.astynkyUzuk.meaning": "Узуктун үстүнөн боз үйдү жиптер менен кайчылаштыра тартышат — алардын сүрөтү сырттан жакшы көрүнөт.",
  "yurt.astynkyUzuk.name": "Астыңкы узук",
  "yurt.astynkyUzuk.purpose": "Күмбөздүн астыңкы бөлүгүн жаап, туурдукка өтүп, жылчык калтырбайт.",
  "yurt.astynkyUzuk.related.0": "Арткы узук",
  "yurt.astynkyUzuk.related.1": "Туурдук",
  "yurt.astynkyUzuk.related.2": "Кырчоо",
  "yurt.chamgarak.description": "Түндүктүн алкагынын ичинде кайчылашып, анын томпок куполун түзгөн ийри жыгач жаалар.",
  "yurt.chamgarak.eyebrow": "Түндүктүн кайчылашы",
  "yurt.chamgarak.group": "Сөөгү",
  "yurt.chamgarak.meaning": "Чамгарактын кайчылашкан жаалары Кыргызстандын мамлекеттик желегиндеги күндүн ичинде сүрөттөлгөн.",
  "yurt.chamgarak.name": "Чамгарак",
  "yurt.chamgarak.purpose": "Түндүккө бекемдик берип, алкактын уук менен кийиздин салмагынан кыйшайышына жол бербейт.",
  "yurt.chamgarak.related.0": "Түндүк",
  "yurt.chamgarak.related.1": "Уук",
  "yurt.chiy.description": "Талаадагы чий чөбүнүн сабактарынан жасалган чий. Ар бир сабакты түстүү жүн менен орошот да, алардан оюм түзүлөт.",
  "yurt.chiy.eyebrow": "Оюмдуу чий",
  "yurt.chiy.group": "Жасалгасы",
  "yurt.chiy.meaning": "Оюмдуу чий (ороо чий) — эң көп эмгекти талап кылган аялдар өнөрлөрүнүн бири, аны менен бүт үй-бүлө сыймыктанат.",
  "yurt.chiy.name": "Чий",
  "yurt.chiy.purpose": "Кереге менен кийиздин ортосуна коюлат: шамал менен чаңдан коргоп, ысыкта аба өткөрөт.",
  "yurt.chiy.related.0": "Кереге",
  "yurt.chiy.related.1": "Туурдук",
  "yurt.chiy.related.2": "Эшик",
  "yurt.eshik.description": "Боз үйгө кирүүчү жер: жыгач эшик алкагы (босого) жана күндүзү түрүлүп, үстүнөн байлап коюлуучу кийиз эшик.",
  "yurt.eshik.eyebrow": "Боз үйгө кирүү",
  "yurt.eshik.group": "Кирүү",
  "yurt.eshik.meaning": "Босого — үй дүйнөсүнүн чеги: аны баспайт жана үстүнө отурбайт. Эшик салт боюнча чыгышка, күн чыгышка каратылат.",
  "yurt.eshik.name": "Эшик",
  "yurt.eshik.purpose": "Кереге шакегиндеги эшик ойдугун жаап, суук менен шамалдан коргойт.",
  "yurt.eshik.related.0": "Кереге",
  "yurt.eshik.related.1": "Туурдук",
  "yurt.eshik.related.2": "Чий",
  "yurt.jabykBash.description": "Боз үйдүн ичинде ууктар боюнча айлана өткөн, сайма оюмдуу жана чачылуу кийиз же кездеме тилкеси.",
  "yurt.jabykBash.eyebrow": "Оюмдуу тилке",
  "yurt.jabykBash.group": "Жасалгасы",
  "yurt.jabykBash.meaning": "Жабык баштын оюмдары бул күмбөздүн астында жашаган үй-бүлөгө береке жана бакубаттык каалоосун билдирет.",
  "yurt.jabykBash.name": "Жабык баш",
  "yurt.jabykBash.purpose": "Күмбөздү ичинен кооздоп, ууктарды өз ара кошумча бекемдейт.",
  "yurt.jabykBash.related.0": "Уук",
  "yurt.jabykBash.related.1": "Тизгич",
  "yurt.kerege.description": "Жыйылып-жайылуучу торчо дубал. Өз ара кайыш менен байланган өзүнчө бөлүктөрдөн — канаттардан турат.",
  "yurt.kerege.eyebrow": "Турак-жайдын дубалдары",
  "yurt.kerege.group": "Сөөгү",
  "yurt.kerege.meaning": "Боз үйдүн чоңдугу канаттардын саны менен өлчөнөт. Эң кеңири тарагандары — алты канат, алты бөлүктөн турган боз үй.",
  "yurt.kerege.name": "Кереге",
  "yurt.kerege.purpose": "Боз үйдүн жүк көтөрүүчү тегерек негизи; жыйналган түрүндө ат же төө менен ыңгайлуу ташылат.",
  "yurt.kerege.related.0": "Кереге чалгыч",
  "yurt.kerege.related.1": "Уук",
  "yurt.kerege.related.2": "Чий",
  "yurt.keregeChalgych.description": "Керегени эң жогору жагынан, ууктар дубалдарга бекитилген жерден курчаган кең токулган тасма.",
  "yurt.keregeChalgych.eyebrow": "Баш чалгыч",
  "yurt.keregeChalgych.group": "Байлоолор",
  "yurt.keregeChalgych.meaning": "Тасманы оюм менен токушат, ошондуктан боз үйдүн ичинде ал бекиткич да, кооздук да.",
  "yurt.keregeChalgych.name": "Кереге чалгыч",
  "yurt.keregeChalgych.purpose": "Дубалдарды тартып, ууктардын түртүүсүн кабыл алып, керегенин тарап кетишине жол бербейт.",
  "yurt.keregeChalgych.related.0": "Кереге",
  "yurt.keregeChalgych.related.1": "Ууктун матоосу",
  "yurt.keregeChalgych.related.2": "Кырчоо",
  "yurt.kyrchoo.description": "Боз үйдү сырттан дубалдары жана куполу боюнча курчап турган өрүлгөн жүн жиптер.",
  "yurt.kyrchoo.eyebrow": "Курчап турган жип",
  "yurt.kyrchoo.group": "Байлоолор",
  "yurt.kyrchoo.meaning": "Жиптердин жана ийкемдүү сөөктүн аркасында боз үй катуу шамалга, ал тургай жер титирөөгө да туруштук берет.",
  "yurt.kyrchoo.name": "Кырчоо",
  "yurt.kyrchoo.purpose": "Кийизди сөөккө кысып, жабууну шамал учуруп кетпесин.",
  "yurt.kyrchoo.related.0": "Туурдук",
  "yurt.kyrchoo.related.1": "Астыңкы узук",
  "yurt.kyrchoo.related.2": "Кереге чалгыч",
  "yurt.size.diameter": "4,5–8 м",
  "yurt.size.height": "4–5 м",
  "yurt.size.keregeHeight": "2 м",
  "yurt.size.title": "Алты канат — керегенин алты бөлүгүнөн турган боз үй",
  "yurt.tizgich.description": "Куполдун болжол менен ортосунда бардык ууктар аркылуу айланып өткөн ичке тасма.",
  "yurt.tizgich.eyebrow": "Уук тизгич",
  "yurt.tizgich.group": "Байлоолор",
  "yurt.tizgich.meaning": "Кичинекей бөлүк, ансыз купол формасын жоготот: ар бир карагай башкалары менен бирге турат.",
  "yurt.tizgich.name": "Тизгич",
  "yurt.tizgich.purpose": "Ууктарды тартып, алардын ортосундагы аралыкты бирдей кармайт, карагайлар тарап кетпесин.",
  "yurt.tizgich.related.0": "Уук",
  "yurt.tizgich.related.1": "Жабык баш",
  "yurt.tunduk.description": "Куполдун чокусундагы тегерек жыгач алкак. Анын тешиктерине бардык ууктардын үстүңкү учтары сайылат.",
  "yurt.tunduk.eyebrow": "Боз үйдүн жүрөгү",
  "yurt.tunduk.group": "Сөөгү",
  "yurt.tunduk.meaning": "Үй очогунун, уруунун жана муундар уланышынын символу: түндүк мураска калат. Түндүктөн өтүп, дубалдар боюнча жылган күн нуру көчмөндөргө саат катары кызмат кылган — ал аркылуу күндүн убактысын аныкташкан.",
  "yurt.tunduk.name": "Түндүк",
  "yurt.tunduk.purpose": "Куполду туташтырып кармап турат, жарык киргизүүчү терезе жана очоктун түтүн чыгаруучу жолу болуп кызмат кылат.",
  "yurt.tunduk.related.0": "Чамгарак",
  "yurt.tunduk.related.1": "Уук",
  "yurt.tunduk.related.2": "Түндүк жабуу",
  "yurt.tundukJabuu.description": "Түндүктү үстүнөн жапкан өзүнчө төрт бурчтуу кийиз. Анын бурчтарына жиптер байланган.",
  "yurt.tundukJabuu.eyebrow": "Түндүктүн жабуусу",
  "yurt.tundukJabuu.group": "Жабуу",
  "yurt.tundukJabuu.meaning": "Эртең менен жабык түндүк жабуу — үйдөгүлөр али уктап жатканынын белгиси; ачык болсо — күн башталды.",
  "yurt.tundukJabuu.name": "Түндүк жабуу",
  "yurt.tundukJabuu.purpose": "Ичинен жип менен түндүктү ачып же жабышат: жарык киргизип, түтүн чыгарып, түнкүсүн жана жаан-чачында жылуулукту сакташат.",
  "yurt.tundukJabuu.related.0": "Түндүк",
  "yurt.tundukJabuu.related.1": "Арткы узук",
  "yurt.tuurduk.description": "Керегени сырттан, чийдин үстүнөн ороп турган узун кийиздер.",
  "yurt.tuurduk.eyebrow": "Дубалдын кийизи",
  "yurt.tuurduk.group": "Жабуу",
  "yurt.tuurduk.meaning": "Туурдукка кийизди бүт үй-бүлө жана кошуналар менен басышат — бул жалпы иш жана жалпы майрам.",
  "yurt.tuurduk.name": "Туурдук",
  "yurt.tuurduk.purpose": "Дубалдарды жылытып, шамалдан коргойт. Жайында боз үйдү желдетүү үчүн астыңкы четин көтөрүп коюшат.",
  "yurt.tuurduk.related.0": "Кереге",
  "yurt.tuurduk.related.1": "Чий",
  "yurt.tuurduk.related.2": "Кырчоо",
  "yurt.uuk.description": "Куполдун узун ийри карагайлары. Үстүңкү учтары түндүккө кирет, астыңкылары керегенин баштарына байланат.",
  "yurt.uuk.eyebrow": "Куполдун карагайлары",
  "yurt.uuk.group": "Сөөгү",
  "yurt.uuk.meaning": "Ууктар түндүктөн күндүн нурларындай таралат — ошондуктан боз үйдүн ичинен күмбөзү асмандын образы катары кабыл алынат.",
  "yurt.uuk.name": "Уук",
  "yurt.uuk.purpose": "Чатырдын сөөгүн түзүп, куполдун жана кийиз жабуунун салмагын дубалдарга өткөрөт.",
  "yurt.uuk.related.0": "Түндүк",
  "yurt.uuk.related.1": "Кереге",
  "yurt.uuk.related.2": "Ууктун матоосу",
  "yurt.uuktunMatoosu.description": "Ууктардын астыңкы учтарын керегенин баштарындагы айрыларга байлаган илмектер жана кайыштар.",
  "yurt.uuktunMatoosu.eyebrow": "Ууктарды бекитүү",
  "yurt.uuktunMatoosu.group": "Байлоолор",
  "yurt.uuktunMatoosu.meaning": "Боз үй бир да мыксыз куралат — баары жыгачтын так ылайыкташуусуна жана бекем байламталарга таянат.",
  "yurt.uuktunMatoosu.name": "Ууктун матоосу",
  "yurt.uuktunMatoosu.purpose": "Куполду дубалдар менен оңой чечилип, оңой куралуучу бирдиктүү конструкцияга бириктирет.",
  "yurt.uuktunMatoosu.related.0": "Уук",
  "yurt.uuktunMatoosu.related.1": "Кереге",
  "yurt.uuktunMatoosu.related.2": "Кереге чалгыч"
}